# Keep the build context small. NOTE: seeds/ is NOT ignored - the runtime seed
# loader reads config from seeds/*.csv. Generated runtime data is excluded so the
# image ships code + config only.
.git
tests
docs
data/*.db
data/*.db-wal
data/*.db-shm
data/digests/
data/backups/
data/.ingest.lock
**/__pycache__
*.pyc
.venv
venv
.env
